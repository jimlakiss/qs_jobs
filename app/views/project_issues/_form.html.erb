<% title_prefix = [@project.code.presence, @project.address.presence].compact.join(" - ") %>
<% revision_label = @project_issue.revision.to_s.strip.presence&.then { |value| "Revision #{value}" } %>
<% version_label = @project_issue.version.to_s.strip.presence&.then { |value| "Version #{value}" } %>
<% revision_version = [revision_label, version_label].compact.join(" ").presence %>
<% title_preview = @project_issue.title.presence || [title_prefix.presence, @project_issue.description.presence || "<purpose>", revision_version].compact.join(" | ") %>

<%= form_with model: @project_issue,
      url: form_url,
      method: form_method,
      local: true,
      class: "issue-form",
      data: {
        controller: "project-issue-title",
        project_issue_title_prefix_value: title_prefix
      } do |f| %>
  <% if @project_issue.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @project_issue.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-12">
      <%= f.label :recipient_user_id, "Recipient", class: "form-label" %>
      <%= f.collection_select :recipient_user_id,
            @project_issue_recipients,
            :id,
            ->(user) { @project_issue_recipient_labels[user.id] || user.email },
            { prompt: "Choose an assigned contributor" },
            class: "form-select" %>
    </div>

    <% if @project_issue_unavailable_contributors.any? %>
      <div class="col-12">
        <div class="alert alert-warning mb-0">
          <div class="fw-semibold mb-1">Assigned contributors without portal access</div>
          <ul class="mb-0">
            <% @project_issue_unavailable_contributors.each do |contributor| %>
              <li><%= link_to contributor.company_name, contributor_path(contributor) %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="col-12">
      <%= f.label :title, "Title", class: "form-label" %>
      <%= text_field_tag :title_preview,
            title_preview,
            class: "form-control",
            data: { project_issue_title_target: "preview" },
            disabled: true %>
    </div>

    <div class="col-md-6">
      <%= f.label :description, "Purpose", class: "form-label" %>
      <%= f.text_field :description,
            class: "form-control",
            placeholder: "Estimate Issue",
            data: {
              project_issue_title_target: "purpose",
              action: "input->project-issue-title#update"
            } %>
    </div>

    <div class="col-md-3">
      <%= f.label :revision, class: "form-label" %>
      <%= f.text_field :revision,
            class: "form-control",
            placeholder: "A",
            data: {
              project_issue_title_target: "revision",
              action: "input->project-issue-title#update"
            } %>
    </div>

    <div class="col-md-3">
      <%= f.label :version, class: "form-label" %>
      <%= f.text_field :version,
            class: "form-control",
            placeholder: "1",
            data: {
              project_issue_title_target: "version",
              action: "input->project-issue-title#update"
            } %>
    </div>

    <div class="col-12">
      <%= f.label :body, "Message", class: "form-label" %>
      <%= f.text_area :body, class: "form-control", rows: 6, placeholder: "Cover note shown in the portal and email." %>
    </div>

    <% if @project_issue.persisted? %>
      <div class="col-12">
        <label class="form-label">Current Attachments</label>
        <% if @project_issue.documents.attached? %>
          <div class="document-list">
            <% @project_issue.documents.each do |document| %>
              <div class="document-row">
                <div class="document-row-main">
                  <div class="fw-semibold"><%= document.filename.to_s %></div>
                  <div class="text-muted small">
                    <%= document.blob.content_type.presence || "Unknown type" %>
                    ·
                    <%= number_to_human_size(document.byte_size) %>
                    ·
                    <%= document.created_at.strftime("%d %b %Y") %>
                  </div>
                </div>
                <div class="stack-actions">
                  <%= link_to "Download", rails_blob_path(document, disposition: "attachment"), class: "btn btn-outline-secondary btn-sm" %>
                  <%= link_to "Remove",
                        document_project_issue_path(@project, @project_issue, document),
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Remove #{document.filename} from this issued package?"
                        },
                        class: "btn btn-outline-danger btn-sm" %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted mb-0">No attachments are currently available.</p>
        <% end %>
      </div>
    <% end %>

    <div class="col-12">
      <%= f.label :documents, @project_issue.persisted? ? "Add Attachments" : "Attachments", class: "form-label" %>
      <%= f.file_field :documents, multiple: true, direct_upload: true, class: "form-control" %>
      <div class="form-text" data-direct-upload-status></div>
    </div>

    <% if @project_issue.persisted? %>
      <div class="col-12">
        <div class="form-check">
          <%= check_box_tag "project_issue[replace_documents]", "1", false, class: "form-check-input", id: "project_issue_replace_documents" %>
          <%= label_tag "project_issue_replace_documents", "Replace existing attachments with selected files", class: "form-check-label" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="stack-actions mt-4">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <% if @project_issue.persisted? %>
      <%= f.submit "Save and Resend Email", class: "btn btn-outline-primary" %>
      <%= link_to "Cancel", project_issue_path(@project, @project_issue), class: "btn btn-outline-secondary" %>
    <% else %>
      <%= link_to "Cancel", project_path(@project), class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
<% end %>
