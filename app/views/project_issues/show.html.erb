<section class="app-page">
  <div class="page-header">
    <div>
      <span class="pill-note">Issued documents</span>
      <h1 class="page-title"><%= @project_issue.title %></h1>
      <p class="page-subtitle"><%= @project_issue.description.presence || @project.code %></p>
    </div>

    <div class="stack-actions">
      <%= link_to "Edit Issue", edit_project_issue_path(@project, @project_issue), class: "btn btn-primary" %>
      <%= button_to "Delete Issue",
            project_issue_path(@project, @project_issue),
            method: :delete,
            form: { data: { turbo_confirm: "Delete this issued document package? The recipient will no longer be able to access it." } },
            class: "btn btn-outline-danger" %>
      <%= link_to "Back to Project", project_path(@project), class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <%= render "issued_documents/project_issue", project_issue: @project_issue, admin_view: true %>
</section>
