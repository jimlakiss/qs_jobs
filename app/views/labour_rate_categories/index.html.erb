<% content_for :title, "Rate Categories | iQs Jobs" %>
<section class="app-page">
  <div class="page-header">
    <div>
      <span class="pill-note">Admin settings</span>
      <h1 class="page-title">Rate Categories</h1>
      <p class="page-subtitle">Manage the roles available in every client’s hourly rate schedule.</p>
      <p class="text-muted mb-0">Codes must be unique, up to 20 characters, using letters, numbers, dots and hyphens. Remove archives a category. Delete permanently deletes an unused category; categories in use are protected.</p>
    </div>
    <%= link_to "Hourly Rate Averages", labour_rate_averages_path, class: "btn btn-outline-secondary" %>
  </div>
  <div class="app-card mb-4"><div class="app-card-body">
    <h2 class="h4">Add category</h2>
    <%= render "form", category: @new_category %>
  </div></div>
  <% { "Active categories" => @categories.select(&:active?), "Removed categories" => @categories.reject(&:active?) }.each do |heading, categories| %>
    <div class="app-card table-shell mb-4">
      <div class="app-card-body border-bottom"><h2 class="h4 mb-0"><%= heading %> (<%= categories.size %>)</h2></div>
      <div class="table-responsive"><table class="table align-middle mb-0">
        <thead class="table-light"><tr><th>Code</th><th>Role</th><th>Section</th><th>Sort order</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
          <% categories.each do |category| %>
            <tr>
              <td class="fw-semibold"><%= category.code %></td>
              <td class="<%= 'ps-4' if category.subheading? %>"><%= category.name %></td>
              <td><%= category.section %></td><td><%= category.position %></td>
              <td><div class="d-flex justify-content-end gap-2">
                <%= link_to "Edit", edit_labour_rate_category_path(category), class: "btn btn-outline-secondary btn-sm" %>
                <% if category.active? %>
                  <%= button_to "Remove", labour_rate_category_path(category), method: :patch, params: { labour_rate_category: { active: false } }, class: "btn btn-outline-secondary btn-sm" %>
                <% else %>
                  <%= button_to "Restore", labour_rate_category_path(category), method: :patch, params: { labour_rate_category: { active: true } }, class: "btn btn-outline-primary btn-sm" %>
                <% end %>
                <%= button_to "Delete", labour_rate_category_path(category), method: :delete, disabled: @rate_counts.fetch(category.key, 0).positive?, title: @rate_counts.fetch(category.key, 0).positive? ? "In use — remove instead" : "Permanently delete category", form: { data: { turbo_confirm: "Permanently delete #{category.code} — #{category.name}? This cannot be undone." } }, class: "btn btn-outline-danger btn-sm" %>
              </div></td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
    </div>
  <% end %>
</section>
