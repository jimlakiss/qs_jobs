<section class="app-page">
  <div class="page-header">
    <div>
      <span class="pill-note"><%= admin_user? ? "Client intake" : "Client portal" %></span>
      <h1 class="page-title"><%= admin_user? ? "Client Area" : "Client Area" %></h1>
      <p class="page-subtitle"><%= admin_user? ? "Review incoming client work and convert accepted submissions into projects." : "Track your uploads and download documents issued by the iQs Jobs team." %></p>
    </div>

    <% if admin_user? %>
      <div class="stack-actions">
        <% if @show_archived %>
          <%= link_to "Active Uploads", client_submissions_path, class: "btn btn-outline-secondary" %>
        <% else %>
          <%= link_to "Archived Uploads", client_submissions_path(archived: true), class: "btn btn-outline-secondary" %>
        <% end %>
      </div>
    <% else %>
      <%= link_to "New Submission", new_client_submission_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <% unless admin_user? %>
    <div class="app-card table-shell">
      <div class="app-card-body">
        <div class="section-title">
          <div>
            <h2 class="h4">Issued Documents</h2>
            <p class="page-subtitle mb-0">Files issued to you by the iQs Jobs team.</p>
          </div>
          <%= link_to "View All", issued_documents_path, class: "btn btn-outline-secondary btn-sm" %>
        </div>

        <% if @project_issues.any? %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Project Number</th>
                  <th>Title</th>
                  <th>Issued</th>
                  <th class="text-end">Files</th>
                </tr>
              </thead>
              <tbody>
                <% @project_issues.first(5).each do |issue| %>
                  <tr>
                    <td><span class="fw-semibold"><%= issue.project.code.presence || "—" %></span></td>
                    <td><%= link_to issue.title, issued_document_path(issue), class: "fw-semibold text-decoration-none" %></td>
                    <td><%= sydney_datetime(issue.sent_at || issue.created_at) %></td>
                    <td class="text-end"><%= issue.documents.count %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted mb-0">No documents have been issued to you yet.</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="app-card table-shell">
    <% unless admin_user? %>
      <div class="app-card-body border-bottom">
        <div class="section-title mb-0">
          <div>
            <h2 class="h4">Your Uploads</h2>
            <p class="page-subtitle mb-0">Drafts and project documents you have submitted to iQs Jobs.</p>
          </div>
        </div>
      </div>
    <% end %>

    <% if @client_submissions.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Project Number</th>
              <th>Reference</th>
              <% if admin_user? %>
                <th>Client</th>
              <% end %>
              <th>Required By</th>
              <th>Status</th>
              <th>Address</th>
              <th class="text-end">Documents</th>
              <% if admin_user? %>
                <th class="text-end">Actions</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @client_submissions.each do |submission| %>
              <tr>
                <td>
                  <% if submission.project.present? %>
                    <% if admin_user? %>
                      <%= link_to submission.project.code, submission.project, class: "fw-semibold text-decoration-none" %>
                    <% else %>
                      <span class="fw-semibold"><%= submission.project.code %></span>
                    <% end %>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td><%= link_to submission.client_reference_code.presence || "Submission ##{submission.id}", submission, class: "fw-semibold text-decoration-none" %></td>
                <% if admin_user? %>
                  <td>
                    <div class="fw-semibold"><%= submission.contributor.company_name %></div>
                    <div class="text-muted small"><%= submission.submitted_by.email %></div>
                  </td>
                <% end %>
                <td><%= submission.required_by&.strftime("%d/%m/%y") || "—" %></td>
                <td><span class="badge text-bg-light"><%= submission.status.humanize %></span></td>
                <td><%= submission.address.presence || "—" %></td>
                <td class="text-end"><%= submission.documents.count %></td>
                <% if admin_user? %>
                  <td class="text-end">
                    <div class="d-flex justify-content-end gap-2">
                      <% if submission.archived? %>
                        <%= button_to "Restore",
                              unarchive_client_submission_path(submission),
                              method: :post,
                              class: "btn btn-outline-secondary btn-sm" %>
                      <% else %>
                        <%= button_to "Archive",
                              archive_client_submission_path(submission),
                              method: :post,
                              class: "btn btn-outline-secondary btn-sm" %>
                      <% end %>
                      <%= button_to "Delete",
                            client_submission_path(submission),
                            method: :delete,
                            form: { data: { turbo_confirm: "Delete this client upload package? This will not delete any linked project." } },
                            class: "btn btn-outline-danger btn-sm" %>
                    </div>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <h2 class="h4 mb-2"><%= admin_user? && @show_archived ? "No archived submissions" : "No submissions yet" %></h2>
        <p class="mb-3"><%= admin_user? ? "Client submissions will appear here once they are uploaded." : "Create a draft to start uploading documents." %></p>
        <% unless admin_user? %>
          <%= link_to "New Submission", new_client_submission_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
